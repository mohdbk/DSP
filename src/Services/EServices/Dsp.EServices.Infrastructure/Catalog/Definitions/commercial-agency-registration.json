{
  "code": "COMMERCIAL_AGENCY_REGISTRATION",
  "name": {
    "en": "Commercial Agency Registration",
    "ar": "تسجيل وكالة تجارية"
  },
  "description": {
    "en": "Register a commercial agency agreement between a UAE agent and a foreign principal.",
    "ar": "سجّل اتفاقية وكالة تجارية بين وكيل إماراتي وموكّل أجنبي."
  },
  "category": {
    "en": "Business",
    "ar": "الأعمال"
  },
  "fee": 500,
  "currency": "AED",
  "referenceField": "agentCompany",
  "workflowVersion": 1,
  "reviewChecklist": [
    {
      "en": "The agreement names the same agent and principal as the application.",
      "ar": "تذكر الاتفاقية الوكيل والموكِّل أنفسهم المذكورين في الطلب."
    },
    {
      "en": "The agreement is signed by both parties and covers the products listed.",
      "ar": "الاتفاقية موقعة من الطرفين وتشمل المنتجات المذكورة."
    },
    {
      "en": "The agreement runs for at least one year.",
      "ar": "مدة الاتفاقية سنة واحدة على الأقل."
    }
  ],
  "steps": [
    {
      "id": "agent",
      "title": {
        "en": "Agent (UAE company)",
        "ar": "الوكيل (شركة إماراتية)"
      },
      "fields": [
        {
          "key": "agentCompany",
          "label": {
            "en": "Agent company name",
            "ar": "اسم شركة الوكيل"
          },
          "type": "text",
          "required": true,
          "maxLength": 150
        },
        {
          "key": "tradeLicenseNumber",
          "label": {
            "en": "Trade licence number",
            "ar": "رقم الرخصة التجارية"
          },
          "type": "text",
          "required": true,
          "pattern": "^[A-Za-z0-9-]{4,20}$",
          "patternMessage": {
            "en": "Enter the licence number as shown on the licence.",
            "ar": "أدخل رقم الرخصة كما يظهر في الرخصة."
          }
        },
        {
          "key": "contactEmail",
          "label": {
            "en": "Contact email",
            "ar": "البريد الإلكتروني للتواصل"
          },
          "type": "email",
          "required": true,
          "prefillFrom": "email"
        },
        {
          "key": "contactMobile",
          "label": {
            "en": "Contact mobile",
            "ar": "رقم الهاتف المتحرك للتواصل"
          },
          "type": "phone",
          "required": true,
          "pattern": "^(\\+?971|0)?5\\d{8}$",
          "patternMessage": {
            "en": "Enter a UAE mobile number, e.g. 971501234567.",
            "ar": "أدخل رقم هاتف متحرك إماراتي، مثل 971501234567."
          },
          "prefillFrom": "mobile"
        }
      ]
    },
    {
      "id": "principal",
      "title": {
        "en": "Foreign principal",
        "ar": "الموكّل الأجنبي"
      },
      "fields": [
        {
          "key": "principalName",
          "label": {
            "en": "Principal company name",
            "ar": "اسم شركة الموكّل"
          },
          "type": "text",
          "required": true,
          "maxLength": 150
        },
        {
          "key": "principalCountry",
          "label": {
            "en": "Principal country",
            "ar": "دولة الموكّل"
          },
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "DE",
              "label": {
                "en": "Germany",
                "ar": "ألمانيا"
              }
            },
            {
              "value": "FR",
              "label": {
                "en": "France",
                "ar": "فرنسا"
              }
            },
            {
              "value": "IT",
              "label": {
                "en": "Italy",
                "ar": "إيطاليا"
              }
            },
            {
              "value": "JP",
              "label": {
                "en": "Japan",
                "ar": "اليابان"
              }
            },
            {
              "value": "KR",
              "label": {
                "en": "South Korea",
                "ar": "كوريا الجنوبية"
              }
            },
            {
              "value": "US",
              "label": {
                "en": "United States",
                "ar": "الولايات المتحدة"
              }
            },
            {
              "value": "GB",
              "label": {
                "en": "United Kingdom",
                "ar": "المملكة المتحدة"
              }
            },
            {
              "value": "CN",
              "label": {
                "en": "China",
                "ar": "الصين"
              }
            }
          ]
        },
        {
          "key": "productLines",
          "label": {
            "en": "Products or services covered",
            "ar": "المنتجات أو الخدمات المشمولة"
          },
          "type": "textarea",
          "required": true,
          "minLength": 10,
          "maxLength": 1000
        }
      ]
    },
    {
      "id": "agreement",
      "title": {
        "en": "Agency agreement",
        "ar": "اتفاقية الوكالة"
      },
      "fields": [
        {
          "key": "agreementStart",
          "label": {
            "en": "Agreement start date",
            "ar": "تاريخ بدء الاتفاقية"
          },
          "type": "date",
          "required": true
        },
        {
          "key": "agreementEnd",
          "label": {
            "en": "Agreement end date",
            "ar": "تاريخ انتهاء الاتفاقية"
          },
          "type": "date",
          "required": true,
          "help": {
            "en": "Agreements must run for at least one year.",
            "ar": "يجب ألا تقل مدة الاتفاقية عن سنة واحدة."
          }
        },
        {
          "key": "agreementFile",
          "label": {
            "en": "Signed agency agreement (PDF)",
            "ar": "اتفاقية الوكالة الموقعة (PDF)"
          },
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "id": "declaration",
      "title": {
        "en": "Declaration",
        "ar": "الإقرار"
      },
      "fields": [
        {
          "key": "declaration",
          "label": {
            "en": "I confirm the information provided is correct and complete",
            "ar": "أقر بأن المعلومات المقدمة صحيحة وكاملة"
          },
          "type": "checkbox",
          "required": true
        }
      ]
    }
  ]
}
