{
  "code": "TRADE_NAME_RESERVATION",
  "name": {
    "en": "Trade Name Reservation",
    "ar": "حجز اسم تجاري"
  },
  "description": {
    "en": "Reserve a trade name for a new business before applying for a trade licence.",
    "ar": "احجز اسمًا تجاريًا لنشاطك الجديد قبل التقدم بطلب الرخصة التجارية."
  },
  "category": {
    "en": "Business",
    "ar": "الأعمال"
  },
  "fee": 200,
  "currency": "AED",
  "referenceField": "tradeNameEn",
  "workflowVersion": 2,
  "reviewChecklist": [
    {
      "en": "The Arabic trade name is written in Arabic letters and matches the meaning of the English name.",
      "ar": "الاسم التجاري العربي مكتوب بحروف عربية ويطابق معنى الاسم الإنجليزي."
    },
    {
      "en": "The trade name does not imitate a well-known brand, a government body or a ruling family name.",
      "ar": "لا يقلّد الاسم التجاري علامة تجارية معروفة أو جهة حكومية أو اسم أسرة حاكمة."
    },
    {
      "en": "The trade name is not offensive and does not mislead about the business activity.",
      "ar": "الاسم التجاري غير مسيء ولا يضلل بشأن النشاط التجاري."
    },
    {
      "en": "The trade name is not confusingly similar to names already reserved.",
      "ar": "الاسم التجاري لا يشبه أسماء محجوزة بالفعل بشكل يسبب اللبس."
    }
  ],
  "steps": [
    {
      "id": "applicant",
      "title": {
        "en": "Applicant details",
        "ar": "بيانات مقدم الطلب"
      },
      "description": {
        "en": "We filled in what we know from your UAE PASS profile. Check and complete it.",
        "ar": "عبأنا ما نعرفه من ملفك في الهوية الرقمية. يرجى المراجعة والإكمال."
      },
      "fields": [
        {
          "key": "fullName",
          "label": {
            "en": "Full name",
            "ar": "الاسم الكامل"
          },
          "type": "text",
          "required": true,
          "maxLength": 150,
          "prefillFrom": "name"
        },
        {
          "key": "emiratesId",
          "label": {
            "en": "Emirates ID",
            "ar": "رقم الهوية الإماراتية"
          },
          "type": "text",
          "required": true,
          "placeholder": {
            "en": "784-1990-1234567-1",
            "ar": "784-1990-1234567-1"
          },
          "pattern": "^784-\\d{4}-\\d{7}-\\d$",
          "patternMessage": {
            "en": "Enter the Emirates ID as 784-YYYY-NNNNNNN-N.",
            "ar": "أدخل رقم الهوية بالصيغة 784-YYYY-NNNNNNN-N."
          },
          "prefillFrom": "emirates_id"
        },
        {
          "key": "email",
          "label": {
            "en": "Email",
            "ar": "البريد الإلكتروني"
          },
          "type": "email",
          "required": true,
          "prefillFrom": "email"
        },
        {
          "key": "mobile",
          "label": {
            "en": "Mobile number",
            "ar": "رقم الهاتف المتحرك"
          },
          "type": "phone",
          "required": true,
          "placeholder": {
            "en": "9715XXXXXXXX",
            "ar": "9715XXXXXXXX"
          },
          "pattern": "^(\\+?971|0)?5\\d{8}$",
          "patternMessage": {
            "en": "Enter a UAE mobile number, e.g. 971501234567.",
            "ar": "أدخل رقم هاتف متحرك إماراتي، مثل 971501234567."
          },
          "prefillFrom": "mobile"
        }
      ]
    },
    {
      "id": "trade-name",
      "title": {
        "en": "Trade name",
        "ar": "الاسم التجاري"
      },
      "description": {
        "en": "Choose the name you want to reserve and tell us about the business.",
        "ar": "اختر الاسم الذي تريد حجزه وأخبرنا عن النشاط."
      },
      "fields": [
        {
          "key": "tradeNameEn",
          "label": {
            "en": "Trade name (English)",
            "ar": "الاسم التجاري (بالإنجليزية)"
          },
          "type": "text",
          "required": true,
          "minLength": 3,
          "maxLength": 60,
          "help": {
            "en": "Names with reserved words such as Ministry or Federal are not allowed.",
            "ar": "لا يُسمح بالأسماء التي تتضمن كلمات محجوزة مثل وزارة أو اتحادي."
          }
        },
        {
          "key": "tradeNameAr",
          "label": {
            "en": "Trade name (Arabic)",
            "ar": "الاسم التجاري (بالعربية)"
          },
          "type": "text",
          "required": true,
          "minLength": 3,
          "maxLength": 60,
          "help": {
            "en": "Write the name in Arabic letters.",
            "ar": "اكتب الاسم بالحروف العربية."
          }
        },
        {
          "key": "legalForm",
          "label": {
            "en": "Legal form",
            "ar": "الشكل القانوني"
          },
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "llc",
              "label": {
                "en": "Limited Liability Company (LLC)",
                "ar": "شركة ذات مسؤولية محدودة"
              }
            },
            {
              "value": "sole",
              "label": {
                "en": "Sole Establishment",
                "ar": "مؤسسة فردية"
              }
            },
            {
              "value": "civil",
              "label": {
                "en": "Civil Company",
                "ar": "شركة مدنية"
              }
            }
          ]
        },
        {
          "key": "activity",
          "label": {
            "en": "Main business activity",
            "ar": "النشاط الرئيسي"
          },
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "general-trading",
              "label": {
                "en": "General trading",
                "ar": "تجارة عامة"
              }
            },
            {
              "value": "consultancy",
              "label": {
                "en": "Management consultancy",
                "ar": "استشارات إدارية"
              }
            },
            {
              "value": "ecommerce",
              "label": {
                "en": "E-commerce",
                "ar": "تجارة إلكترونية"
              }
            },
            {
              "value": "tourism",
              "label": {
                "en": "Tourism services",
                "ar": "خدمات سياحية"
              }
            }
          ]
        },
        {
          "key": "emirate",
          "label": {
            "en": "Emirate",
            "ar": "الإمارة"
          },
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "AUH",
              "label": {
                "en": "Abu Dhabi",
                "ar": "أبوظبي"
              }
            },
            {
              "value": "DXB",
              "label": {
                "en": "Dubai",
                "ar": "دبي"
              }
            },
            {
              "value": "SHJ",
              "label": {
                "en": "Sharjah",
                "ar": "الشارقة"
              }
            },
            {
              "value": "AJM",
              "label": {
                "en": "Ajman",
                "ar": "عجمان"
              }
            },
            {
              "value": "UAQ",
              "label": {
                "en": "Umm Al Quwain",
                "ar": "أم القيوين"
              }
            },
            {
              "value": "RAK",
              "label": {
                "en": "Ras Al Khaimah",
                "ar": "رأس الخيمة"
              }
            },
            {
              "value": "FUJ",
              "label": {
                "en": "Fujairah",
                "ar": "الفجيرة"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "declaration",
      "title": {
        "en": "Declaration",
        "ar": "الإقرار"
      },
      "fields": [
        {
          "key": "declaration",
          "label": {
            "en": "I confirm the information provided is correct and complete",
            "ar": "أقر بأن المعلومات المقدمة صحيحة وكاملة"
          },
          "type": "checkbox",
          "required": true
        }
      ]
    }
  ]
}
